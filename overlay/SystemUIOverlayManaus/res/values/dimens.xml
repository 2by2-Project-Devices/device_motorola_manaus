    <!-- Location on the screen of the center of the physical volume up/down buttons. -->
    <dimen name="physical_volume_up_button_center_screen_location_y">535.0px</dimen>
    <dimen name="physical_volume_down_button_center_screen_location_y">692.0px</dimen>
